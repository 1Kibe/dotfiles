#!/usr/bin/env bash
# Keybind list read from the running Hyprland (hyprctl binds), so it always
# matches the config. Bound to Super+F1. Bind descriptions look like
# "Group: text" (see modules/keybinds.lua). Hyprland doesn't list the
# touchpad gestures: they come from the same data file modules/keybinds.lua
# reads (Configurações → Gestos, dotfiles_gestures.lua), read here as text
# only, with the same names and defaults.
#
#   hypr-atalhos                  list in a pager (q closes), with the
#                                 gestures chosen on this machine
#   hypr-atalhos --json           the list for Configurações → Atalhos: one
#                                 array of { g: group, t: text, k: [keys] },
#                                 the sections in order, then the chosen
#                                 gestures
#   hypr-atalhos --markdown       tables in Markdown, with the default
#                                 gestures (the README is the repo's): the
#                                 keybinds of modules/keybinds.lua only,
#                                 never local.lua nor the running Hyprland
#   hypr-atalhos --readme FILE    replaces the tables between the markers
#                                 <!-- atalhos:inicio --> and <!-- atalhos:fim -->
set -euo pipefail
# A failing hyprctl inside $(...) must stop the script, so the README is not
# rewritten with an empty table
shopt -s inherit_errexit

SECTIONS=(Sistema Janelas Áreas Mídia)

# Each gesture: "position|as shown|default" (modules/keybinds.lua's
# positions and defaults)
GESTURE_PLACES=(
  "3:left|3 dedos ←|cycle_prev"
  "3:right|3 dedos →|cycle_next"
  "3:up|3 dedos ↑|overview"
  "3:down|3 dedos ↓|empty_area"
  "4:side|4 dedos ←/→|areas"
  "4:up|4 dedos ↑|media_next"
  "4:down|4 dedos ↓|media_prev"
  "4:pinch|4 dedos (pinça)|media_play"
)
# What each name does, as Configurações → Gestos says it ("none": no gesture,
# left out). 4 fingers sideways takes only areas, cycle or none
declare -A GESTURE_LABELS=(
  [cycle_prev]="Janela anterior" [cycle_next]="Próxima janela" [overview]="Visão geral das janelas"
  [launcher]="Abrir o lançador" [controlcenter]="Central de controle" [empty_area]="Ir para uma área vazia"
  [media_next]="Próxima música" [media_prev]="Música anterior" [media_play]="Tocar / pausar"
  [volume_up]="Aumentar o volume" [volume_down]="Diminuir o volume" [capture]="Captura de tela"
  [lock]="Travar a tela" [none]=""
)
declare -A SIDE_LABELS=([areas]="Trocar de área de trabalho" [cycle]="Janela anterior / próxima" [none]="")
GESTURE_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/hypr/dotfiles_gestures.lua"

# The gestures as "as shown|action" lines. With "chosen": the names of
# dotfiles_gestures.lua, read as text only (never run): a plain file (not a
# link) up to 4 KB, each line exactly the shell's `  ["3:left"] = "name",`.
# A position missing, a name it does not take or anything else on the line:
# that position's default. Without "chosen": the defaults
gestures() {
  local -A chosen=()
  local line place id shown def name label
  if [[ "${1:-}" == chosen && -f "$GESTURE_FILE" && ! -L "$GESTURE_FILE" ]] \
      && (( $(stat -c %s -- "$GESTURE_FILE" 2>/dev/null || echo 99999) <= 4096 )); then
    while IFS= read -r line || [[ -n "$line" ]]; do
      if [[ "$line" =~ ^\ \ \[\"([34]:[a-z]+)\"\]\ =\ \"([a-z_]+)\",$ ]]; then
        chosen["${BASH_REMATCH[1]}"]="${BASH_REMATCH[2]}"
      fi
    done < "$GESTURE_FILE" || true
  fi
  for place in "${GESTURE_PLACES[@]}"; do
    IFS='|' read -r id shown def <<< "$place"
    name="${chosen[$id]:-$def}"
    if [[ "$id" == 4:side ]]; then
      [[ -v "SIDE_LABELS[$name]" ]] || name="$def"
      label="${SIDE_LABELS[$name]}"
    else
      [[ -v "GESTURE_LABELS[$name]" ]] || name="$def"
      label="${GESTURE_LABELS[$name]}"
    fi
    [[ -n "$label" ]] && printf '%s|%s\n' "$shown" "$label"
  done
  return 0
}

# The repo's keybinds (for the README): modules/keybinds.lua next to this
# script in the repo, run by the system's lua with a fake hl that only
# records each bind, in the same JSON as `hyprctl -j binds` (key, modmask,
# release, description). The file is loaded as text only, with an
# environment that has only what it needs to read: no os, io, load,
# dofile, loadfile or debug, and a require that gives only the two fake
# modules it uses. Anything else it reaches for stops the generator with a
# message, never acting.
SOURCE=session
KEYBINDS="$(dirname -- "$(readlink -f -- "$0")")/../../.config/hypr/modules/keybinds.lua"
repo_binds() {
  if ! command -v lua >/dev/null; then
    echo "hypr-atalhos: falta o lua (pacote lua) para ler o keybinds.lua" >&2
    return 1
  fi
  if [[ ! -f "$KEYBINDS" ]]; then
    echo "hypr-atalhos: keybinds.lua não encontrado ao lado do script, no repo" >&2
    return 1
  fi
  lua - "$KEYBINDS" <<'LUA'
local path = arg[1]
local binds = {}
-- Any hl.dsp.<...>(...) is a placeholder: nothing runs
local placeholder
placeholder = setmetatable({}, { __index = function() return placeholder end, __call = function() return placeholder end })
local hl = {
  bind = function(keys, _, flags)
    if type(keys) == "string" and type(flags) == "table" and type(flags.description) == "string" then
      binds[#binds + 1] = { keys = keys, description = flags.description, release = flags.release == true }
    end
  end,
  gesture = function() end,
  dispatch = function() end,
  on = function() end,
  dsp = placeholder,
}
local actions = setmetatable({ data_file = function() return nil end },
  { __index = function(_, k) return "action:" .. tostring(k) end })
local areas = setmetatable({}, { __index = function() return function() end end })
local modules = { ["modules.actions"] = actions, ["modules.areas"] = areas }
local env = {
  string = string, table = table, ipairs = ipairs, pairs = pairs, select = select, type = type,
  tostring = tostring, tonumber = tonumber, error = error, pcall = pcall, rawget = rawget, hl = hl,
  require = function(name)
    local m = modules[name]
    if m == nil then
      error("o keybinds.lua pediu o módulo " .. tostring(name) .. ", que o gerador não tem", 0)
    end
    return m
  end,
}
local chunk, err = loadfile(path, "t", env)
if not chunk then
  io.stderr:write("hypr-atalhos: não deu para ler o keybinds.lua: " .. tostring(err) .. "\n")
  os.exit(1)
end
local ok, e = pcall(chunk)
if not ok then
  io.stderr:write("hypr-atalhos: o keybinds.lua usou algo que o gerador não oferece: " .. tostring(e) .. "\n")
  os.exit(1)
end
local function json(s)
  return '"' .. s:gsub('[%c"\\]', function(c) return string.format("\\u%04x", c:byte()) end) .. '"'
end
local bits = { SUPER = 64, CTRL = 4, CONTROL = 4, ALT = 8, SHIFT = 1 }
local out = {}
for _, b in ipairs(binds) do
  local parts = {}
  for p in (b.keys .. " + "):gmatch("(.-) %+ ") do parts[#parts + 1] = p end
  local key, mask = parts[#parts], 0
  for i = 1, #parts - 1 do
    local bit = bits[parts[i]:upper()]
    if not bit then
      io.stderr:write("hypr-atalhos: modificador desconhecido no keybinds.lua: " .. parts[i] .. "\n")
      os.exit(1)
    end
    mask = mask | bit
  end
  out[#out + 1] = string.format('{"key":%s,"modmask":%d,"release":%s,"description":%s}',
    json(key), mask, b.release and "true" or "false", json(b.description))
end
io.write("[", table.concat(out, ","), "]\n")
LUA
}

# One item per action, as JSON: { g, t, k: [keys] }. Binds with the same
# group and text are merged (k gets both); runs like Super+1..9 become one
# "Super+1..9". Every other output is made from this one. SOURCE=session:
# the running Hyprland (hyprctl binds, local.lua's too); repo: the repo's
# keybinds.lua only
binds_json() {
  local json
  if [[ "$SOURCE" == repo ]]; then
    json="$(repo_binds)" || return 1
  elif ! json="$(hyprctl -j binds)"; then
    echo "hypr-atalhos: hyprctl falhou (rodando fora do Hyprland?)" >&2
    return 1
  fi
  # Only binds whose description has a "Group: " prefix are listed. modmask
  # is a bit field (Shift 1, Ctrl 4, Alt 8, Super 64); a bind on Super_L
  # itself shows just "Super", not "Super+Super".
  jq -r '
    def pretty:
      {"Super_L": "Super", "space": "Espaço", "Return": "Enter",
       "left": "←", "right": "→", "up": "↑", "down": "↓",
       "Escape": "Esc", "Delete": "Del",
       "mouse:272": "botão esquerdo", "mouse:273": "botão direito",
       "mouse_down": "roda ↓", "mouse_up": "roda ↑",
       "XF86AudioRaiseVolume": "Volume +", "XF86AudioLowerVolume": "Volume −",
       "XF86AudioMute": "Mudo", "XF86AudioMicMute": "Microfone mudo",
       "XF86MonBrightnessUp": "Brilho +", "XF86MonBrightnessDown": "Brilho −",
       "XF86AudioPlay": "Play", "XF86AudioPause": "Pause",
       "XF86AudioNext": "Próxima", "XF86AudioPrev": "Anterior",
       "switch:on:Lid Switch": "Fechar a tampa"}[.] // .;
    def mods($m):
      [ (if (($m / 64) | floor) % 2 == 1 then "Super" else empty end),
        (if (($m / 4) | floor) % 2 == 1 then "Ctrl" else empty end),
        (if (($m / 8) | floor) % 2 == 1 then "Alt" else empty end),
        (if $m % 2 == 1 then "Shift" else empty end) ];
    def compact:
      if length > 2
         and all(.[]; test("[0-9]$"))
         and ((map(sub("[0-9]$"; "")) | unique | length) == 1)
      then [.[0] + ".." + (.[-1] | .[-1:])]
      else . end;
    [ .[]
      | select((.description // "") | test("^[^:]+: "))
      | (.description | capture("^(?<g>[^:]+): (?<t>.*)$")) as $d
      | { g: $d.g, t: $d.t,
          k: ((if .key == "Super_L" then [] else mods(.modmask // 0) end) + [(.key | pretty)] | join("+"))
             + (if .release then " (soltar)" else "" end) } ]
    | reduce .[] as $r ([];
        if any(.[]; .g == $r.g and .t == $r.t)
        then map(if .g == $r.g and .t == $r.t then .k += [$r.k] else . end)
        else . + [{ g: $r.g, t: $r.t, k: [$r.k] }] end)
    | map({ g, t, k: (.k | compact) })' <<< "$json"
}

# One line per action: "group<TAB>keys<TAB>text" (keys joined by " / ")
binds_tsv() {
  local list
  list="$(binds_json)"
  jq -r '.[] | [.g, (.k | join(" / ")), .t] | @tsv' <<< "$list"
}

# Configurações → Atalhos: the sections in their order (a group missing from
# SECTIONS is left out, as in the tables), then the gestures. Any failure:
# nothing printed and a non-zero exit (set -e)
json_list() {
  local list sections gestures
  list="$(binds_json)"
  sections="$(printf '%s\n' "${SECTIONS[@]}" | jq -R -s -c 'split("\n") | map(select(length > 0))')"
  gestures="$(gestures chosen | jq -R -s -c \
    'split("\n") | map(select(length > 0) | split("|") | { g: "Gestos do touchpad", t: .[1], k: [.[0]] })')"
  jq -c -n --argjson list "$list" --argjson sections "$sections" --argjson gestures "$gestures" \
    '[$sections[] as $s | $list[] | select(.g == $s)] + $gestures'
}

markdown() {
  local tsv section g
  tsv="$(binds_tsv)"
  # Fixed section order; a group with no binds gets no empty table, and a
  # group missing from SECTIONS is not shown
  for section in "${SECTIONS[@]}"; do
    grep -q "^${section}"$'\t' <<< "$tsv" || continue
    printf '\n### %s\n\n| Atalho | Ação |\n|---|---|\n' "$section"
    # A "|" would end the cell and a backtick the code span: escaped (keys
    # with a backtick get a double-backtick span)
    awk -F'\t' -v s="$section" '$1 == s {
      k = $2; t = $3
      gsub(/\|/, "\\|", k); gsub(/\|/, "\\|", t); gsub(/`/, "\\`", t)
      if (index(k, "`") > 0) printf "| `` %s `` | %s |\n", k, t
      else printf "| `%s` | %s |\n", k, t
    }' <<< "$tsv"
  done
  printf '\n### Gestos do touchpad\n\n| Gesto | Ação |\n|---|---|\n'
  while IFS= read -r g; do
    printf '| %s | %s |\n' "${g%%|*}" "${g#*|}"
  done < <(gestures)
}

pager() {
  local tsv section g
  tsv="$(binds_tsv)"
  {
    echo "Atalhos do Hyprland (q fecha)"
    for section in "${SECTIONS[@]}"; do
      grep -q "^${section}"$'\t' <<< "$tsv" || continue
      printf '\n%s\n' "$section"
      awk -F'\t' -v s="$section" '$1 == s { printf "  %-34s %s\n", $2, $3 }' <<< "$tsv"
    done
    printf '\nGestos do touchpad\n'
    while IFS= read -r g; do
      printf '  %-34s %s\n' "${g%%|*}" "${g#*|}"
    done < <(gestures chosen)
  } | less
}

update_readme() {
  local readme="$1" table
  if ! grep -q '<!-- atalhos:inicio -->' "$readme" || ! grep -q '<!-- atalhos:fim -->' "$readme"; then
    echo "hypr-atalhos: marcadores não encontrados em $readme" >&2
    return 1
  fi
  table="$(markdown)"
  # The table goes in through the environment (awk -v would turn its
  # backslashes into escapes). The old lines between the markers are
  # skipped; a temp file plus mv never leaves a half-written README.
  TABLE="$table" awk '
    /<!-- atalhos:inicio -->/ { print; print ENVIRON["TABLE"]; print ""; skip = 1; next }
    /<!-- atalhos:fim -->/ { skip = 0 }
    !skip { print }
  ' "$readme" > "${readme}.tmp"
  mv "${readme}.tmp" "$readme"
}

case "${1:-}" in
  "") pager ;;
  --json) json_list ;;
  --markdown) SOURCE=repo; markdown ;;
  --readme) SOURCE=repo; update_readme "${2:?usage: hypr-atalhos --readme FILE}" ;;
  *)
    echo "usage: hypr-atalhos [--json | --markdown | --readme FILE]" >&2
    exit 2
    ;;
esac
