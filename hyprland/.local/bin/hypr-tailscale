#!/usr/bin/env bash
# Connects or disconnects Tailscale in the terminal the control center
# opens (Kitty with the class qs-central, sent to the special workspace by
# hypr/modules/rules.lua): sudo tailscale up|down, where the password is
# typed (and, logged out, the login address shows). The window closes by
# itself after a "Pronto" line when it worked; on an error it waits for
# Enter, so the message (tailscale's own, printed above) can be read. Only
# one runs at a time (a lock in the session's runtime directory).
#
# One argument from a fixed list: up or down (exit 2 with anything else).
set -u
(( $# == 1 )) || exit 2
case "$1" in
  up|down) ;;
  *) exit 2 ;;
esac

# One at a time: a second window says so and waits, instead of a second
# sudo over the first
lock="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/hypr-tailscale.lock"
exec 9>"$lock"
if ! flock -n 9; then
  echo "Já há uma janela do Tailscale aberta. Enter para fechar."
  read -r _ || true
  exit 1
fi

sudo tailscale "$1"
rc=$?

echo
if (( rc == 0 )); then
  echo "Pronto."
  sleep 2
  exit 0
fi
echo "Não terminou (código $rc). Enter para fechar."
read -r _ || true
exit "$rc"
