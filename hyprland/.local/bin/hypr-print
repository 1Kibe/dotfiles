#!/usr/bin/env bash
# Screenshot saved to Pictures/Capturas and copied to the clipboard.
# Bound to Shift+Print (tela), Super+Shift+S (area) and Alt+Print (janela)
# in Hyprland; Print itself opens the Quickshell capture bar.
# Cancelling the area selection (Esc, or the same key again) saves nothing.
#
# Usage: hypr-print tela|area|janela
set -euo pipefail

mode="${1:-}"
case "$mode" in
  tela)
    geometry=""
    ;;
  area)
    # Pressed again while choosing: cancel that selection instead of opening
    # another one on top (stacked selections lighten the screen and get
    # into the next print)
    if pgrep -x slurp >/dev/null; then
      pkill -x slurp || true
      exit 0
    fi
    geometry="$(slurp)" || exit 0
    ;;
  janela)
    geometry="$(hyprctl -j activewindow \
      | jq -r 'if .at then "\(.at[0]),\(.at[1]) \(.size[0])x\(.size[1])" else "" end')"
    [[ -n "$geometry" ]] || exit 0
    ;;
  *)
    echo "usage: hypr-print tela|area|janela" >&2
    exit 2
    ;;
esac

pictures="$(xdg-user-dir PICTURES 2>/dev/null || true)"
dir="${pictures:-$HOME/Pictures}/Capturas"
file="${dir}/$(date +%Y-%m-%d_%H-%M-%S).png"
mkdir -p "$dir"

if [[ -n "$geometry" ]]; then
  grim -g "$geometry" "$file"
else
  grim "$file"
fi
wl-copy --type image/png < "$file"
# Card in the corner (Quickshell); nothing if the shell is not running
qs ipc call capture card "$file" >/dev/null 2>&1 || true
echo "$file"
