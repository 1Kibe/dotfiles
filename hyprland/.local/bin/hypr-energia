#!/usr/bin/env bash
# Power menu in rofi: log out, suspend, reboot, power off. The reserve for
# when the shell is down (the power section of the control center is the
# usual one); bound to no key. Esc closes it and does nothing.
#
# Usage: hypr-energia
set -euo pipefail

logout="󰍃  Sair"
suspend="󰤄  Suspender"
reboot="󰜉  Reiniciar"
poweroff="󰐥  Desligar"

# rofi exits non-zero on Esc: nothing chosen, nothing done
choice="$(printf '%s\n' "$logout" "$suspend" "$reboot" "$poweroff" \
  | rofi -dmenu -i -p Energia)" || exit 0

case "$choice" in
  "$logout")   hypr-sair ;;
  # Locks first; sleeps only once the lock is confirmed
  "$suspend")  hypr-suspender ;;
  "$reboot")   systemctl reboot ;;
  "$poweroff") systemctl poweroff ;;
  *) exit 0 ;;
esac
