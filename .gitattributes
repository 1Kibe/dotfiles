# Scripts and configs read on Linux: always LF
*.sh       text eol=lf
*.awk      text eol=lf
*.desktop  text eol=lf
*.conf     text eol=lf
**/.local/bin/* text eol=lf

# Strip XFCE runtime cache (Wi-Fi names) before committing; see tools/xfce-panel-clean.awk
# Matched by name so the rule keeps working if the file moves to another package.
**/xfce4-panel.xml filter=xfce-panel

# Strip the per-monitor wallpaper (connector names, /home/<user> paths); see tools/xfce-desktop-clean.awk
**/xfce4-desktop.xml filter=xfce-desktop
