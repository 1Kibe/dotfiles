# Thumbnails (tumbler, used by Thunar): only images get one (JPEG and the
# formats gdk-pixbuf reads). Video, PDF, fonts, documents, e-books, camera
# RAW and the external thumbnailers are off: a thumbnail runs a parser on
# the file as soon as its folder opens, which a file from a pendrive should
# not get for free. Every section of the system file is here, so this file
# decides whether tumbler merges it with the system one or not.

[JPEGThumbnailer]
Disabled=false
Priority=3
Locations=
Excludes=
MaxFileSize=0

[RawThumbnailer]
Disabled=true
Priority=3
Locations=
Excludes=
MaxFileSize=0

[PixbufThumbnailer]
Disabled=false
Priority=2
Locations=
Excludes=
MaxFileSize=0

[CoverThumbnailer]
Disabled=true
Priority=3
Locations=~/movies
Excludes=
MaxFileSize=0

[FfmpegThumbnailer]
Disabled=true
Priority=2
Locations=
Excludes=
MaxFileSize=0

[GstThumbnailer]
Disabled=true
Priority=1
Locations=
Excludes=
MaxFileSize=0

[FontThumbnailer]
Disabled=true
Priority=1
Locations=
Excludes=
MaxFileSize=0

[PopplerThumbnailer]
Disabled=true
Priority=1
Locations=
Excludes=
MaxFileSize=0

[OdfThumbnailer]
Disabled=true
Priority=1
Locations=
Excludes=
MaxFileSize=0

[EpubThumbnailer]
Disabled=true
Priority=1
Locations=
Excludes=
MaxFileSize=0

[DesktopThumbnailer]
Disabled=true
Priority=0
Locations=
Excludes=
MaxFileSize=0
