# ── Neovim ──
# lazy.nvim plugin directory (downloaded automatically)
nvim/lazy/
nvim/plugin/
nvim/after/

# Mason installed tools (downloaded automatically)
nvim/mason/

# Treesitter parsers (compiled automatically)
nvim/parser/

# Neovim general cache
nvim/spell/
nvim/undo/
nvim/swap/
nvim/backup/
nvim/view/
nvim/session/
nvim/log/

# ── System junk ──
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── Backups ──
*.bak
*.backup
*.old

# install.sh backups (full ~/.config tarballs, may contain tokens/cookies)
.backups/

# ── Secrets ──
.env
.env.local
*.secret

# ── Hyprland: machine-specific settings ──
hyprland/.config/hypr/local.lua
# Generated by the shell's settings (Configurações → Aparência), and the
# temporary file of its atomic write if a crash leaves it
hyprland/.config/hypr/dotfiles_settings.lua*

# ── Kitty: the theme's colors (written by the shell) and machine-only
# settings, with the temporary files of their atomic writes ──
common/.config/kitty/cores.conf*
common/.config/kitty/local*.conf*

# ── btop: its themes folder (the theme written by the shell from its
# colors, and the temporary file of its atomic write) ──
common/.config/btop/themes/
